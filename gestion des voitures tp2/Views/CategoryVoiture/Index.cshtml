    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<gestion_des_voitures_tp2.Models.CategoryVoiture>

@{
    ViewData["Title"] = "Gestion des Catégories de Véhicules";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 mb-1">Catégories de Voitures</h1>
            <p class="text-muted mb-0">Gestion du catalogue des segments automobiles de votre agence de location</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> + Nouvelle Catégorie
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Succès !</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 border rounded bg-light">
            <div class="display-6 text-muted mb-3">🚗</div>
            <h4 class="text-muted">Aucune catégorie enregistrée</h4>
            <p class="text-secondary">Commencez par ajouter une nouvelle catégorie de véhicule ci-dessus.</p>
            <a asp-action="Create" class="btn btn-outline-primary">Ajouter ma première catégorie</a>
        </div>
    }
    else
    {
        <div class="table-responsive bg-white rounded shadow-sm border">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Image</th>
                        <th style="width: 80px;">ID</th>
                        <th>Libellé</th>
                        <th>Description</th>
                        <th style="width: 240px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Libelle" class="rounded object-fit-cover shadow-sm" style="width: 75px; height: 50px;" />
                                }
                                else
                                {
                                    <div class="bg-secondary bg-opacity-25 rounded d-flex align-items-center justify-content-center text-secondary font-monospace" style="width: 75px; height: 50px; font-size: 0.75rem;">
                                        Sans photo
                                    </div>
                                }
                            </td>
                            <td class="fw-bold text-muted">#@item.Id</td>
                            <td>
                                <strong class="text-primary fs-6">@item.Libelle</strong>
                            </td>
                            <td class="text-muted">
                                @(string.IsNullOrEmpty(item.Description) ? "Aucune description fournie." : item.Description)
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">Détails</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">Modifier</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>